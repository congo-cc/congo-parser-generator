<project name="congocc" default="jar" basedir=".">
  <import file="common.xml" />
  <tstamp>
    <format property="timestamp" pattern="yyyy-MM-dd HH:mm:ss" />
  </tstamp>

  <target name="init">
    <uptodate
      property="parser.uptodate"
      targetfile="build/generated-java/org/congocc/parser/CongoCCParser.java"
    >
      <srcfiles dir="src/grammars" includes="CongoCC.ccc" />
      <srcfiles dir="src/grammars" includes="Lexical.inc.ccc" />
      <srcfiles dir="src/grammars" includes="JavaInternal.ccc" />
      <srcfiles dir="examples/java" includes="*.ccc" />
    </uptodate>
    <uptodate
      property="preprocessor.uptodate"
      targetfile="build/generated-java/org/congocc/preprocessor/PreprocessorParser.java"
      srcfile="examples/preprocessor/Preprocessor.ccc"
    />
    <uptodate
      property="python.uptodate"
      targetfile="build/generated-java/org/congocc/parser/python/PythonParser.java"
    >
      <srcfiles dir="src/grammars" includes="PythonInternal.ccc" />
      <srcfiles dir="examples/python" includes="*.ccc" />
    </uptodate>
    <uptodate
      property="csharp.uptodate"
      targetfile="build/generated-java/org/congocc/parser/csharp/CSharpParser.java"
    >
      <srcfiles dir="src/grammars" includes="CSharpInternal.ccc" />
      <srcfiles dir="examples/csharp" includes="*.ccc" />
    </uptodate>
    <uptodate
      property="rust.uptodate"
      targetfile="build/generated-java/org/congocc/parser/rust/RustParser.java"
    >
      <srcfiles dir="src/grammars" includes="RustInternal.ccc" />
      <srcfiles dir="examples/rust" includes="*.ccc" />
    </uptodate>
    <uptodate
      property="ppline.uptodate"
      targetfile="build/generated-java/org/parsers/csharp/ppline/PPDirectiveLineParser.java"
      srcfile="examples/csharp/PPDirectiveLine.ccc"
    />
  </target>

  <target name="restore-bootstrap-jar">
    <exec executable="git" dir="bin">
      <arg line="checkout congocc.jar" />
    </exec>
  </target>

  <!-- Ensure template-engine/ exists (git submodule) before nested ant or compile. -->
  <target name="check-template-engine">
    <available file="template-engine/build.xml" property="template.engine.present" />
  </target>

  <target name="check-for-bootstrap">
    <available file="bin/congocc.jar" property="bootstrap.jar.present" />
  </target>

  <target
    name="init-template-submodule"
    depends="check-template-engine"
    unless="template.engine.present"
  >
    <echo>Initializing template-engine submodule...</echo>
    <exec executable="git" dir="${basedir}" failonerror="true">
      <arg line="submodule update --init --recursive" />
    </exec>
  </target>

  <target
    name="init-bootstrap"
    depends="check-for-bootstrap"
    unless="bootstrap.jar.present"
  >
    <echo>Initializing bootstrap jar submodule...</echo>
    <exec executable="git" dir="${basedir}" failonerror="true">
      <arg line="submodule update --init --recursive" />
    </exec>
  </target>


  <!--
     Build and test using the bootstrap jarfile, then
     drop in the newly built jarfile and build and test again
-->
  <target name="full-test" depends="restore-bootstrap-jar,clean,jar,test">
    <echo>Now we copy the new congocc.jar over rebootstrap</echo>
    <copy file="congocc.jar" todir="bin" />
    <antcall target="clean" />
    <antcall target="test" />
  </target>

  <target name="clean" depends="init-template-submodule">
    <delete file="congocc.jar" />
    <delete dir="build" />
    <ant target="clean" dir="template-engine" />
  </target>

  <target name="parser-gen" unless="parser.uptodate">
    <congocc-use-bootstrap target="src/grammars/CongoCC.ccc" />
  </target>
  <target name="preprocessor-gen" unless="preprocessor.uptodate">
    <congocc-use-bootstrap target="examples/preprocessor/Preprocessor.ccc" />
  </target>
  <target name="ppline-gen" unless="ppline.uptodate">
    <congocc-use-bootstrap
      target="examples/csharp/PPDirectiveLine.ccc"
      args="-n -q -d ../../build/generated-java"
    />
  </target>
  <target name="python-gen" unless="python.uptodate">
    <congocc-use-bootstrap target="src/grammars/PythonInternal.ccc" />
  </target>
  <target name="csharp-gen" unless="csharp.uptodate">
    <congocc-use-bootstrap target="src/grammars/CSharpInternal.ccc" />
  </target>
  <target name="rust-gen" unless="rust.uptodate">
    <congocc-use-bootstrap target="src/grammars/RustInternal.ccc" />
  </target>

  <target
    name="build-parsers"
    depends="init,
               init-bootstrap,
               build-ctl-code,
               parser-gen,
               preprocessor-gen,
               ppline-gen,
               python-gen,
               csharp-gen,
               rust-gen"
  />

  <target name="compile" depends="build-parsers">
    <javac
      destdir="build"
      deprecation="off"
      debug="on"
      optimize="off"
      failonerror="true"
      includeantruntime="false"
      release="17"
    >
      <src path="src/java" />
      <src path="build/generated-java" />
      <src path="template-engine/src/java" />
      <src path="template-engine/build/generated-java" />
    </javac>
    <copy todir="build" file="LICENSE" />
    <copy todir="build/templates">
      <fileset dir="src/templates">
        <include name="**/*.ctl" />
      </fileset>
    </copy>
    <copy todir="build/include">
      <fileset dir="examples">
        <include name="csharp/*.ccc" />
        <include name="java/*.ccc" />
        <include name="json/*.ccc" />
        <include name="lua/*.ccc" />
        <include name="python/*.ccc" />
        <include name="rust/*.ccc" />
      </fileset>
    </copy>
  </target>

  <target name="test" depends="jar">
    <echo>Testing the JSON Parser</echo>
    <ant dir="examples/json" target="clean" />
    <ant dir="examples/json" target="test-all" />
    <echo>Testing the CICS parser</echo>
    <ant dir="examples/cics" target="clean" />
    <ant dir="examples/cics" target="test-all" />
    <ant dir="examples/cics" target="test-rust" />
    <echo>Testing the Preprocessor</echo>
    <ant dir="examples/preprocessor" target="clean" />
    <ant dir="examples/preprocessor" target="test" />
    <echo>Testing the Lua parser</echo>
    <ant dir="examples/lua" target="clean" />
    <ant dir="examples/lua" target="test-all" />
    <echo>Testing the CSharp parser standalone</echo>
    <ant dir="examples/csharp" target="clean" />
    <ant dir="examples/csharp" target="test-all" />
    <echo>Testing the Java parser standalone</echo>
    <ant dir="examples/java" target="clean" />
    <ant dir="examples/java" target="test-all" />
    <echo>Building the Python parser</echo>
    <ant dir="examples/python" target="clean" />
    <ant dir="examples/python" target="test-all" />
    <echo>Testing the Arithmetic parsers</echo>
    <ant dir="examples/arithmetic" target="clean" />
    <ant dir="examples/arithmetic" target="test" />
    <ant dir="examples/arithmetic" target="test-rust" />
    <echo>Testing the SQL Expression parser</echo>
    <ant dir="examples/sqlexpr" target="clean" />
    <ant dir="examples/sqlexpr" target="test-rust" />
  </target>

  <target name="test-java" depends="jar">
    <echo>Testing the Java parser standalone"</echo>
    <!--ant
    dir="examples/java" target="clean" /-->
    <ant dir="examples/java" target="test-java" />
  </target>

  <!-- Cardinality oracles: sandbox/cardinality (CardTests.ccc) Java/Python/C# and examples/cics
  Java. -->
  <target name="test-cardinality-oracles-java" depends="jar">
    <echo>Cardinality oracle: sandbox/cardinality</echo>
    <ant dir="sandbox/cardinality" target="clean" />
    <ant dir="sandbox/cardinality" target="test-all" />
    <echo>Cardinality oracle: examples/cics</echo>
    <ant dir="examples/cics" target="clean" />
    <ant dir="examples/cics" target="test-java" />
  </target>

  <target name="test-rust-formatter" depends="jar,rust-guard" if="rust.on">
    <echo>Running RustFormatter golden-file tests</echo>
    <javac
      srcdir="tests/rust-formatter"
      destdir="build"
      classpath="congocc.jar"
      includeantruntime="false"
    />
    <java classname="RustFormatterTest" fork="true" failonerror="true">
      <classpath>
        <pathelement path="build" />
        <pathelement location="congocc.jar" />
      </classpath>
    </java>
  </target>

  <target name="test-rust" depends="jar,rust-guard" if="rust.on">
    <echo>Testing Rust parser generation</echo>
    <ant dir="examples/json" target="test-rust" />
    <ant dir="examples/lua" target="test-rust" />
    <ant dir="examples/cics" target="test-rust" />
    <ant dir="examples/arithmetic" target="test-rust" />
    <ant dir="examples/sqlexpr" target="test-rust" />
    <!-- The Rust parser of the Rust grammar, compared with its Java parser -->
    <ant dir="examples/rust" target="test-rust" />
    <!-- The tests of the Rust target itself (tests/rust-codegen) -->
    <antcall target="test-rust-codegen" />
    <!-- Java Rust tests disabled until handwritten Rust code is supplied -->
    <!-- <ant dir="examples/java" target="test-rust" /> -->
    <!-- Python Rust tests disabled until handwritten Rust code is supplied -->
    <!-- <ant dir="examples/python" target="test-rust" /> -->
    <!-- CSharp Rust tests disabled until handwritten Rust code is supplied -->
    <!-- <ant dir="examples/csharp" target="test-rust" /> -->
  </target>

  <!--
    Regression guard for the code generators (tests/generated-output/README.md).
    snapshot-generated-output generates every grammar of the repository for
    every target language with congocc.jar, and stores the generated files
    and the generator's messages in the directory generated-output.dir;
    compare-generated-output compares two snapshots byte for byte (by default
    for Java, Python and C#; set generated-output.langs to change that):

      ant snapshot-generated-output -Dgenerated-output.dir=/tmp/before
      (change the generator)
      ant snapshot-generated-output -Dgenerated-output.dir=/tmp/after
      ant compare-generated-output -Dgenerated-output.baseline=/tmp/before
                                   -Dgenerated-output.candidate=/tmp/after

    compare-generated-output first runs test-generated-output-tool, the
    tool's checks of its own comparison (they take less than a second).
  -->
  <property name="generated-output.langs" value="java,python,csharp" />
  <property name="generated-output.jobs" value="4" />
  <target name="compile-generated-output-tool">
    <mkdir dir="build/generated-output-tool" />
    <javac srcdir="tests/generated-output" includes="GeneratedOutputSnapshot.java"
           destdir="build/generated-output-tool" includeantruntime="false" release="17" encoding="UTF-8"
           debug="true" />
  </target>
  <target name="snapshot-generated-output" depends="jar,compile-generated-output-tool">
    <fail unless="generated-output.dir"
          message="Set the property generated-output.dir to the directory to write the snapshot to." />
    <java classname="GeneratedOutputSnapshot" classpath="build/generated-output-tool" fork="true"
          failonerror="true" dir="${basedir}">
      <arg value="snapshot" />
      <arg value="--jar" />
      <arg value="${basedir}/congocc.jar" />
      <arg value="--repo" />
      <arg value="${basedir}" />
      <arg value="--out" />
      <arg value="${generated-output.dir}" />
      <arg value="--jobs" />
      <arg value="${generated-output.jobs}" />
    </java>
  </target>
  <target name="test-generated-output-tool" depends="compile-generated-output-tool">
    <java classname="GeneratedOutputSnapshot" classpath="build/generated-output-tool" fork="true"
          failonerror="true" dir="${basedir}">
      <arg value="self-test" />
    </java>
  </target>
  <target name="compare-generated-output" depends="test-generated-output-tool">
    <fail message="Set the properties generated-output.baseline and generated-output.candidate to the two snapshot directories.">
      <condition>
        <not>
          <and>
            <isset property="generated-output.baseline" />
            <isset property="generated-output.candidate" />
          </and>
        </not>
      </condition>
    </fail>
    <java classname="GeneratedOutputSnapshot" classpath="build/generated-output-tool" fork="true"
          failonerror="true" dir="${basedir}">
      <arg value="compare" />
      <arg value="${generated-output.baseline}" />
      <arg value="${generated-output.candidate}" />
      <arg value="--langs" />
      <arg value="${generated-output.langs}" />
    </java>
  </target>

  <!--
    Tests of the Rust target (tests/rust-codegen/README.md): the
    -rust-allow-stubs flag, the diagnostics for Java code that cannot be
    translated to Rust, and the feature grammars, whose Rust parsers must
    build the same trees as their Java parsers.  Needs cargo.  To run only
    the tests whose names contain a text, pass it with -only, for example
    ant test-rust-codegen -Drust-codegen.args="-only features/lexing"
  -->
  <property name="rust-codegen.args" value="" />
  <target name="test-rust-codegen" depends="jar,rust-guard" if="rust.available">
    <echo>Testing the Rust target (tests/rust-codegen)</echo>
    <mkdir dir="build/rust-codegen-tests/classes" />
    <javac srcdir="tests/rust-codegen" includes="org/**/*.java" destdir="build/rust-codegen-tests/classes"
           classpath="congocc.jar" includeantruntime="false" release="17" encoding="UTF-8" debug="true" />
    <java classname="org.congocc.codegen.rust.RustCodegenTest" fork="true" failonerror="true" dir="${basedir}">
      <classpath>
        <pathelement location="build/rust-codegen-tests/classes" />
        <pathelement location="congocc.jar" />
      </classpath>
      <arg value="--repo" />
      <arg value="${basedir}" />
      <arg value="--jar" />
      <arg value="${basedir}/congocc.jar" />
      <arg value="--work" />
      <arg value="${basedir}/build/rust-codegen-tests" />
      <arg line="${rust-codegen.args}" />
    </java>
  </target>

  <target name="jar" depends="compile">
    <jar jarfile="congocc.jar" compress="true" excludes="**/*.java">
      <fileset dir="build" includes="LICENSE,include/,org/,templates/" />
      <fileset dir="template-engine/build" excludes="LICENSE"/>
      <manifest>
        <attribute name="Main-Class" value="org.congocc.app.Main" />
        <attribute name="Built-By" value="${user.name}" />
        <attribute name="Build-Date" value="${timestamp}" />
      </manifest>
    </jar>
  </target>

  <target name="build-ctl-code">
    <echo>Updating template engine submodule...</echo>
    <exec executable="git" dir="${basedir}" timeout="10000">
      <arg line="submodule update --init --recursive" />
    </exec>
    <ant dir="template-engine" target="build-parser" />
  </target>

  <target name="update-bootstrap">
    <!--
      Update the bootstrap congocc.jar using the current congocc.jar built from the current
      source. To cater for template changes, the process needs to be repeated once to
      ensure that the templates are up to date, and again to ensure that any generated
      code is using the updated templates.
    -->
    <echo>Ensuring templates are up to date in the bootstrap jar ...</echo>
    <antcall target="clean" />
    <antcall target="jar" />
    <echo>Copying current jar to bootstrap location ...</echo>
    <echo>Ensuring any generated code is up to date in the bootstrap jar ...</echo>
    <antcall target="clean" />
    <antcall target="jar" />
    <echo>Copying current jar to bootstrap location ...</echo>
    <copy file="congocc.jar" todir="bin" />
  </target>
</project>