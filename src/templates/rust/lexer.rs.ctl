[#-- lexer.rs.ctl: NFA-based lexer for the Rust target.

     This template is a port of the Java target's Lexer.java.ctl /
     NfaCode.java.ctl / TokenSource.java.ctl.  The generated lexer must make
     exactly the same tokenization decisions as the generated Java lexer for
     the same grammar, because the parser's lookahead and the shape of the AST
     depend on them.  The points where the Rust lexer deliberately differs
     from Java are listed in the doc comment of the generated `Lexer` struct.

     Generated by CongoCC — do not edit. --]
[#var NFA_RANGE_THRESHOLD = 16]
[#var multipleLexicalStates = lexerData::lexicalStates.size() > 1]
[#-- The Lua grammar implements long brackets with a Java TOKEN_HOOK, which
     the Rust target cannot translate.  The balanced-delimiter emulation
     below replaces that hook, so it is only generated when a token hook
     exists AND the grammar accumulates MORE tokens across a lexical state
     transition (the shape of the Lua long-bracket rules). --]
[#var emulateLongBracketHook = grammar::lexerTokenHooks.size() != 0
                                && lexerData::moreTokens::tokenNames.size() != 0
                                && lexerData::hasLexicalStateTransitions]
// Generated by ${generated_by}. Do not edit.
#![allow(non_snake_case, dead_code, clippy::all)]

use crate::tokens::{TokenType, LexicalState, TokenTypeSet};
use crate::error::ParseError;
use std::borrow::Cow;
use std::collections::HashSet;

/// A single token produced by the lexer.
///
/// Offsets are kept in two units:
///
/// * `start`/`end` are **byte** offsets into the lexer's (munged) content,
///   so `token.text(lexer.source())` is a cheap slice.
/// * `begin_cp`/`end_cp` are **code point** offsets.  They correspond to the
///   `getBeginOffset()`/`getEndOffset()` values of the Java target (which are
///   UTF-16 offsets; the two agree whenever the input has no characters
///   outside the Basic Multilingual Plane).  Code translated from Java grammar
///   actions uses these offsets so that offset arithmetic such as
///   `getEndOffset() - getBeginOffset()` means the same thing in both targets.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
pub struct Token {
    /// The type of this token.
    pub kind: TokenType,
    /// Byte offset of the start of this token in the lexer content.
    pub start: usize,
    /// Byte offset one past the end of this token in the lexer content.
    pub end: usize,
    /// Whether this token is an "unparsed" token (e.g. a comment declared
    /// with `UNPARSED`).  The parser never sees unparsed tokens.
    pub is_unparsed: bool,
    /// Code point offset of the start of this token.
    pub begin_cp: u32,
    /// Code point offset one past the end of this token.
    pub end_cp: u32,
}

impl Token {
    /// Returns the text of this token from the given source input.
    ///
    /// Pass the lexer's content ([`Lexer::source`]) or the AST's source
    /// ([`crate::ast::Ast::source`]); those are the strings the offsets refer
    /// to.  The original input string gives the same result unless the
    /// grammar's settings made the lexer rewrite the input (tab expansion,
    /// line-ending normalization, Java unicode escapes, or an appended final
    /// newline), in which case offsets after the first rewrite differ.
    pub fn text<'a>(&self, source: &'a str) -> &'a str {
        &source[self.start..self.end]
    }

    /// The token that stands in for Java's `null` token: type `DUMMY`,
    /// zero length, at offset 0.  `Parser::get_token` returns it where the
    /// Java parser's `getToken` would return `null` (before the first token).
    pub const fn dummy() -> Token {
        Token { kind: TokenType::DUMMY, start: 0, end: 0, is_unparsed: false, begin_cp: 0, end_cp: 0 }
    }

    /// Returns `true` if this is the [`Token::dummy`] stand-in for `null`.
    #[inline]
    pub fn is_dummy(&self) -> bool {
        self.kind == TokenType::DUMMY
    }

    /// Java `getType()`.
    #[inline]
    pub fn get_type(&self) -> TokenType {
        self.kind
    }

    /// Java `getBeginOffset()`, in code points.
    #[inline]
    pub fn get_begin_offset(&self) -> i32 {
        self.begin_cp as i32
    }

    /// Java `getEndOffset()`, in code points.
    #[inline]
    pub fn get_end_offset(&self) -> i32 {
        self.end_cp as i32
    }

    /// Java `length()`: the number of code points in the token.
    #[inline]
    pub fn length(&self) -> i32 {
        (self.end_cp - self.begin_cp) as i32
    }
}

/// Decodes raw file contents the way the Java target's
/// `TokenSource.stringFromBytes` does: a UTF-8, UTF-16 (BE/LE) or UTF-32
/// (BE/LE) byte-order mark selects the encoding and is removed; otherwise the
/// bytes are decoded as UTF-8.  Malformed sequences become U+FFFD instead of
/// failing, so any file can be lexed.
///
/// Use this when reading source files so that a parse of a file in Rust sees
/// the same characters (and therefore the same offsets) as the Java parser's
/// `new Parser(Path)` constructor.
///
/// # Examples
///
/// ```
/// use ${settings::parserPackage.replace(".", "_")}::lexer::string_from_bytes;
///
/// let text = string_from_bytes(b"\xEF\xBB\xBFfn main() {}");
/// assert_eq!(text, "fn main() {}");
/// ```
pub fn string_from_bytes(bytes: &[u8]) -> String {
    fn decode_utf16(bytes: &[u8], big_endian: bool) -> String {
        let units: Vec<u16> = bytes
            .chunks(2)
            .map(|c| {
                let pair = [c[0], *c.get(1).unwrap_or(&0)];
                if big_endian { u16::from_be_bytes(pair) } else { u16::from_le_bytes(pair) }
            })
            .collect();
        String::from_utf16_lossy(&units)
    }
    fn decode_utf32(bytes: &[u8], big_endian: bool) -> String {
        bytes
            .chunks(4)
            .map(|c| {
                let mut quad = [0u8; 4];
                quad[..c.len()].copy_from_slice(c);
                let v = if big_endian { u32::from_be_bytes(quad) } else { u32::from_le_bytes(quad) };
                char::from_u32(v).unwrap_or('\u{FFFD}')
            })
            .collect()
    }
    match bytes {
        [0xEF, 0xBB, 0xBF, rest @ ..] => String::from_utf8_lossy(rest).into_owned(),
        [0x00, 0x00, 0xFE, 0xFF, rest @ ..] => decode_utf32(rest, true),
        [0xFF, 0xFE, 0x00, 0x00, rest @ ..] => decode_utf32(rest, false),
        [0xFE, 0xFF, rest @ ..] => decode_utf16(rest, true),
        [0xFF, 0xFE, rest @ ..] => decode_utf16(rest, false),
        _ => String::from_utf8_lossy(bytes).into_owned(),
    }
}

// =================================================================
// Content munging (port of Java TokenSource.mungeContent)
// =================================================================

/// Tab stop width used when tabs are expanded (`TAB_SIZE`).
const TAB_SIZE: usize = ${settings::tabSize};
/// `true` unless the grammar asks for tabs to be expanded to spaces.
const PRESERVE_TABS: bool = ${settings::preserveTabs ? "true" : "false"};
/// `true` if `\r` and `\r\n` are kept as they are (`PRESERVE_LINE_ENDINGS`).
const PRESERVE_LINE_ENDINGS: bool = ${settings::preserveLineEndings ? "true" : "false"};
/// `true` if Java `\uXXXX` escapes are decoded (`JAVA_UNICODE_ESCAPE`).
const JAVA_UNICODE_ESCAPE: bool = ${settings::javaUnicodeEscape ? "true" : "false"};
/// String appended when the input does not already end with it
/// (`ENSURE_FINAL_EOL` / `TERMINATING_STRING`).
const TERMINATING_STRING: &str = ${globals.rustStringLiteral(settings::terminatingString)};

/// Rewrites the input exactly the way the Java target's lexer does before
/// tokenizing, so that token offsets and texts agree between the targets:
///
/// 1. tabs are expanded to the next multiple of `TAB_SIZE` unless tabs are
///    preserved (the column counter restarts at every `\n`);
/// 2. `\r\n` and lone `\r` become `\n` unless line endings are preserved;
/// 3. Java unicode escapes (`\uXXXX`, any number of `u`s, not preceded by an
///    odd number of backslashes) are decoded when enabled;
/// 4. `TERMINATING_STRING` is appended if the original input does not end
///    with it.
///
/// As in Java, when tabs and line endings are both preserved and unicode
/// escapes are off the input is returned unchanged — and, matching the Java
/// behavior for `String` input, no terminating string is appended either.
/// The fast path returns `Cow::Borrowed`, so no copy is made.
///
/// Known differences from Java: a malformed `\u` escape is kept as text
/// (Java throws `NumberFormatException`), and an escape that yields a lone
/// UTF-16 surrogate becomes U+FFFD (a Rust `String` cannot hold one).
fn munge_content(content: &str) -> Cow<'_, str> {
    if PRESERVE_TABS && PRESERVE_LINE_ENDINGS && !JAVA_UNICODE_ESCAPE {
        return Cow::Borrowed(content);
    }
    let needs_rewrite = (!PRESERVE_TABS && content.contains('\t'))
        || (!PRESERVE_LINE_ENDINGS && content.contains('\r'))
        || (JAVA_UNICODE_ESCAPE && content.contains("\\u"))
        || (!TERMINATING_STRING.is_empty() && !content.ends_with(TERMINATING_STRING));
    if !needs_rewrite {
        return Cow::Borrowed(content);
    }
    let chars: Vec<char> = content.chars().collect();
    // UTF-16 units are collected (rather than chars) so that a surrogate
    // pair written as two escapes combines into one character.
    let mut out: Vec<u16> = Vec::with_capacity(content.len() + TERMINATING_STRING.len());
    let mut push = |out: &mut Vec<u16>, c: char| {
        let mut buf = [0u16; 2];
        out.extend_from_slice(c.encode_utf16(&mut buf));
    };
    let mut col: usize = 0;
    let mut index = 0usize;
    while index < chars.len() {
        let ch = chars[index];
        index += 1;
        if ch == '\n' {
            push(&mut out, ch);
            col = 0;
        } else if JAVA_UNICODE_ESCAPE && ch == '\\' && index < chars.len() && chars[index] == 'u' {
            let mut preceding_slashes = 0usize;
            let mut i = index;
            while i > 0 && chars[i - 1] == '\\' {
                preceding_slashes += 1;
                i -= 1;
            }
            if preceding_slashes % 2 == 0 {
                push(&mut out, '\\');
                col += 1;
                continue;
            }
            let mut num_us = 0usize;
            while index + num_us < chars.len() && chars[index + num_us] == 'u' {
                num_us += 1;
            }
            let hex_start = index + num_us;
            let hex: String = chars.iter().skip(hex_start).take(4).collect();
            match (hex.chars().count() == 4).then(|| u16::from_str_radix(&hex, 16).ok()).flatten() {
                Some(unit) => {
                    out.push(unit);
                    index = hex_start + 4;
                }
                None => push(&mut out, '\\'),
            }
            col += 1;
        } else if !PRESERVE_LINE_ENDINGS && ch == '\r' {
            push(&mut out, '\n');
            col = 0;
            if index < chars.len() && chars[index] == '\n' {
                index += 1;
            }
        } else if ch == '\t' && !PRESERVE_TABS {
            let spaces = TAB_SIZE - col % TAB_SIZE;
            for _ in 0..spaces {
                push(&mut out, ' ');
                col += 1;
            }
        } else {
            push(&mut out, ch);
            col += 1;
        }
    }
    if !TERMINATING_STRING.is_empty() && !content.ends_with(TERMINATING_STRING) {
        for c in TERMINATING_STRING.chars() {
            push(&mut out, c);
        }
    }
    Cow::Owned(String::from_utf16_lossy(&out))
}

// =================================================================
// NFA machinery (port of NfaCode.java.ctl)
// =================================================================

/// An NFA state transition function: given the current character, it sets
/// the bits of the successor states in `next_states` and returns the token
/// type matched by this step, if any.  `valid_types` are the active token
/// types; `already_matched` holds the types matched at shorter lengths
/// during the current match (used for lazy tokens).
type NfaFunction = fn(u32, &mut [u64], &TokenTypeSet, &TokenTypeSet) -> Option<TokenType>;

[#-- === NFA move arrays for states with large character ranges === --]
[#list lexerData::lexicalStates as lexicalState]
[#list lexicalState::allNfaStates as nfaState]
[#if nfaState::moveRanges.size() >= NFA_RANGE_THRESHOLD]
/// Character ranges for NFA state in lexical state ${lexicalState::name}.
static ${nfaState::movesArrayName.toUpperCase()}: &[u32] = &[
[#list nfaState::moveRanges as char]
    ${char}[#if char_has_next],[/#if]
[/#list]
];
[/#if]
[/#list]
[/#list]

/// Binary search over sorted character range pairs `[lo0, hi0, lo1, hi1, ...]`.
/// Returns `true` if `ch` falls within any `[lo, hi]` range (inclusive).
fn check_intervals(ranges: &[u32], ch: u32) -> bool {
    // An exact hit is a range boundary.  Otherwise the insertion point is
    // odd exactly when `ch` lies strictly inside a pair.
    match ranges.binary_search(&ch) {
        Ok(_) => true,
        Err(pos) => pos % 2 == 1,
    }
}

[#-- The three function shapes mirror NfaCode.java.ctl exactly:
     * the initial state of each lexical state checks the active token types
       before following a transition (this is where inactive tokens are
       pruned, exactly as in Java);
     * a canonical set with a single NFA state becomes a simple test;
     * other composite states test their member states in if/else-if blocks.
     Only the initial state consults `valid_types`; later states are only
     reachable through transitions that the initial state allowed. --]
[#list lexerData::lexicalStates as lexicalState]
[#list lexicalState::canonicalSets as state]
[#if state_index == 0]
[@InitialCompositeNfa state, lexicalState /]
[#elseif state::numStates == 1]
[@SimpleNfa state, lexicalState /]
[#else]
[@CompositeNfa state, lexicalState /]
[/#if]
[/#list]

/// NFA function table for lexical state ${lexicalState::name}.
static NFA_FUNCTIONS_${lexicalState::name.toUpperCase()}: &[NfaFunction] = &[
[#list lexicalState::canonicalSets as state]
    ${state::methodName}[#if state_has_next],[/#if]
[/#list]
];

[/#list]

[#var maxStates = 1]
[#list lexerData::lexicalStates as ls]
  [#if maxStates < ls::allNfaStates.size()]
    [#set maxStates = ls::allNfaStates.size()]
  [/#if]
  [#if maxStates < ls::canonicalSets.size()]
    [#set maxStates = ls::canonicalSets.size()]
  [/#if]
[/#list]
/// Upper bound on the number of NFA states in any lexical state.
const MAX_STATES: usize = ${maxStates};

/// The number of `u64` words needed for the NFA state bitset.
const BITSET_WORDS: usize = (MAX_STATES + 63) / 64;

/// Sets a bit in an NFA state bitset.
#[inline]
fn bitset_set(bits: &mut [u64], index: usize) {
    bits[index >> 6] |= 1u64 << (index & 63);
}

/// Returns the NFA function table for the given lexical state.
#[inline]
fn get_nfa_functions(state: LexicalState) -> &'static [NfaFunction] {
    match state {
[#list lexerData::lexicalStates as lexicalState]
        LexicalState::${lexicalState::name} => NFA_FUNCTIONS_${lexicalState::name.toUpperCase()},
[/#list]
    }
}

${globals.rustSupportCode()}

/// The lexer converts source text into tokens using the grammar's NFA.
///
/// Tokens are produced on demand: [`Parser`](crate::parser::Parser) asks for
/// one token at a time (so that it can change the lexical state or the set of
/// active token types between tokens, exactly like the Java parser), while
/// [`Lexer::tokenize`] lexes the whole input for tools that want a token list.
///
/// The lexer is a faithful port of the Java target's lexer: the same
/// longest-match/lowest-ordinal rule, the same treatment of `SKIP`, `MORE`
/// and `UNPARSED` tokens, lexical actions run for every matched type
/// (including `MORE` and `SKIP` types, where the matched token is `None`),
/// and the same input munging.  Deliberate differences:
///
/// * an unmatchable character produces one `INVALID` token per code point
///   (Java merges a run of unmatchable characters into one token);
/// * offsets count code points where Java counts UTF-16 units, so they
///   differ after a character outside the Basic Multilingual Plane;
/// * Java `TOKEN_HOOK` methods are not translated.  The one shape the
///   generator knows (Lua-style long brackets) is emulated.
///
/// # Examples
///
/// ```no_run
/// use ${settings::parserPackage.replace(".", "_")}::lexer::Lexer;
///
/// let mut lexer = Lexer::new("input text", "input.txt");
/// lexer.tokenize().expect("tokenization failed");
/// for token in lexer.tokens() {
///     println!("{:?} {:?}", token.kind, token.text(lexer.source()));
/// }
/// ```
pub struct Lexer {
    /// The munged input text that all offsets refer to.
    content: String,
    /// The content as code points, for O(1) random access by offset.
    chars: Vec<char>,
    /// `byte_offsets[i]` is the byte offset of `chars[i]`; the extra final
    /// entry is the content's byte length.
    byte_offsets: Vec<u32>,
    /// Source name (e.g., filename) for error reporting.
    source_name: String,
    /// Tokens produced by [`Lexer::tokenize`].
    tokens: Vec<Token>,
    /// Current lexical state.
    lexical_state: LexicalState,
    /// Active token types; `None` means every token type is active.
    active_token_types: Option<TokenTypeSet>,
    /// NFA state bitsets, reused across matches to avoid allocation.
    current_states: Vec<u64>,
    next_states: Vec<u64>,
[#-- Fields from INJECT LEXER_CLASS --]
${globals.rustLexerFieldDeclarations()}}

impl std::fmt::Debug for Lexer {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Lexer")
            .field("source_name", &self.source_name)
            .field("lexical_state", &self.lexical_state)
            .field("active_token_types", &self.active_token_types)
            .finish_non_exhaustive()
    }
}

impl Lexer {
    /// Creates a new lexer for the given source text.
    ///
    /// The text is first rewritten according to the grammar's settings (see
    /// [`Lexer::source`]); token offsets refer to the rewritten text.
    ///
    /// # Arguments
    ///
    /// * `source` - The source text to tokenize.
    /// * `source_name` - Name for the source (e.g., filename), used in error messages.
    pub fn new(source: &str, source_name: &str) -> Self {
        let content = munge_content(source).into_owned();
        let mut chars = Vec::with_capacity(content.len());
        let mut byte_offsets = Vec::with_capacity(content.len() + 1);
        for (byte_pos, ch) in content.char_indices() {
            byte_offsets.push(byte_pos as u32);
            chars.push(ch);
        }
        byte_offsets.push(content.len() as u32);

[#if settings::deactivatedTokens]
        // Java: EnumSet.allOf(TokenType.class) minus the DEACTIVATE_TOKENS.
        let mut active = TokenTypeSet::ALL_TYPES;
  [#list settings::deactivatedTokens as token]
        active.remove(TokenType::${token});
  [/#list]
        let active_token_types = Some(active);
[#else]
        let active_token_types = None;
[/#if]

        Self {
            content,
            chars,
            byte_offsets,
            source_name: source_name.to_string(),
            tokens: Vec::new(),
            lexical_state: LexicalState::default(),
            active_token_types,
            current_states: vec![0u64; BITSET_WORDS],
            next_states: vec![0u64; BITSET_WORDS],
${globals.rustLexerFieldInitializers()}        }
    }

    // =============================================================
    // Public API
    // =============================================================

    /// Tokenizes the entire input, populating the internal token list.
    ///
    /// After this call, the tokens (regular and unparsed, ending with `EOF`)
    /// can be accessed via [`Lexer::tokens`].  Unmatchable input becomes
    /// `INVALID` tokens rather than an error, so the result is always `Ok`;
    /// the `Result` is kept for API stability.
    ///
    /// # Errors
    ///
    /// Currently never returns an error.
    pub fn tokenize(&mut self) -> Result<(), ParseError> {
        let mut position: usize = 0;
        loop {
            let token = self.tokenize_at(position);
            let is_eof = token.kind == TokenType::EOF;
            position = token.end_cp as usize;
            self.tokens.push(token);
            if is_eof {
                break;
            }
        }
        Ok(())
    }

    /// Returns the list of tokens produced by [`Lexer::tokenize`].
    pub fn tokens(&self) -> &[Token] {
        &self.tokens
    }

    /// Returns the source name.
    pub fn source_name(&self) -> &str {
        &self.source_name
    }

    /// Returns the text that token offsets refer to: the input after the
    /// rewriting described in [`Lexer::new`].
    pub fn source(&self) -> &str {
        &self.content
    }

    /// Returns the text of a token produced by this lexer.
    pub fn token_text(&self, token: &Token) -> &str {
        &self.content[token.start..token.end]
    }

    /// Activates a token type so the lexer will recognize it.
    ///
    /// If no active set exists yet (every type is active), a set containing
    /// every grammar token type is created first.
    pub fn activate_token_type(&mut self, tt: TokenType) {
        self.active_token_types
            .get_or_insert_with(TokenTypeSet::all_grammar_types)
            .insert(tt);
    }

    /// Deactivates a token type so the lexer ignores it during matching.
    ///
    /// This is a no-op while no active set exists; use the parser's
    /// `DEACTIVATE_TOKENS` support for Java semantics.
    pub fn deactivate_token_type(&mut self, tt: TokenType) {
        if let Some(active) = self.active_token_types.as_mut() {
            active.remove(tt);
        }
    }

    /// Saves the current set of active tokens (`None` means "all active").
    pub fn save_active_tokens(&self) -> Option<HashSet<TokenType>> {
        self.active_token_types.map(|set| set.to_hash_set())
    }

    /// Restores a previously saved set of active tokens and discards the
    /// tokens produced by [`Lexer::tokenize`] from `from_token_index` on.
    pub fn restore_active_tokens(&mut self, saved: Option<HashSet<TokenType>>, from_token_index: usize) {
        self.active_token_types = saved.map(|set| set.into_iter().collect());
        self.tokens.truncate(from_token_index);
    }

    /// Switches the lexer to a different lexical state.
    ///
    /// Returns `true` if the state changed (Java `switchTo`).
    pub fn switch_to(&mut self, state: LexicalState) -> bool {
        if self.lexical_state != state {
            self.lexical_state = state;
            true
        } else {
            false
        }
    }

    /// Returns the current lexical state.
    pub fn lexical_state(&self) -> LexicalState {
        self.lexical_state
    }

    /// Computes the 1-based line and column of a byte offset in the content.
    /// Columns count code points.
    pub fn line_column(&self, byte_offset: usize) -> (usize, usize) {
        let prefix = &self.content[..byte_offset.min(self.content.len())];
        let line = 1 + prefix.bytes().filter(|&b| b == b'\n').count();
        let line_start = prefix.rfind('\n').map_or(0, |i| i + 1);
        (line, 1 + prefix[line_start..].chars().count())
    }

    // =============================================================
    // Support for the parser (Java token-source semantics)
    // =============================================================

    /// Java `doLexicalStateSwitch`: switches to the state that `tt`
    /// transitions to, if it has one.
    pub(crate) fn do_lexical_state_switch(&mut self, tt: TokenType) -> bool {
[#if lexerData::hasLexicalStateTransitions]
        match crate::tokens::lexical_state_for(tt) {
            Some(state) => self.switch_to(state),
            None => false,
        }
[#else]
        let _ = tt;
        false
[/#if]
    }

    /// Returns `true` if `tt` is currently active.
    #[inline]
    pub(crate) fn is_active(&self, tt: TokenType) -> bool {
        self.active_token_types.as_ref().map_or(true, |set| set.contains(tt))
    }

    /// Snapshot of the active token types, for save/restore around
    /// `ACTIVATE_TOKENS`/`DEACTIVATE_TOKENS` expansions.
    #[inline]
    pub(crate) fn active_snapshot(&self) -> Option<TokenTypeSet> {
        self.active_token_types
    }

    /// Restores a snapshot taken with [`Lexer::active_snapshot`].
    #[inline]
    pub(crate) fn restore_active_snapshot(&mut self, snapshot: Option<TokenTypeSet>) {
        self.active_token_types = snapshot;
    }

    /// Java `activateTokenTypes` (the token-source half): returns `false`
    /// without doing anything when every type is already active, otherwise
    /// adds the types and reports whether the set changed.
    pub(crate) fn activate_types(&mut self, types: &[TokenType]) -> bool {
        let Some(active) = self.active_token_types.as_mut() else {
            return false;
        };
        let mut changed = false;
        for &tt in types {
            changed |= active.insert(tt);
        }
        changed
    }

    /// Java `deactivateTokenTypes` (the token-source half): creates the full
    /// set (`EnumSet.allOf`) if necessary, removes the types and reports
    /// whether the set changed.
    pub(crate) fn deactivate_types(&mut self, types: &[TokenType]) -> bool {
        let active = self.active_token_types.get_or_insert(TokenTypeSet::ALL_TYPES);
        let mut changed = false;
        for &tt in types {
            changed |= active.remove(tt);
        }
        changed
    }

    /// Converts a code point offset to a byte offset.
    #[inline]
    fn byte_offset(&self, cp: usize) -> usize {
        self.byte_offsets[cp.min(self.chars.len())] as usize
    }

    /// Creates a token spanning the code point range `[begin, end)`.
    #[inline]
    fn make_token(&self, kind: TokenType, begin: usize, end: usize, is_unparsed: bool) -> Token {
        Token {
            kind,
            start: self.byte_offset(begin),
            end: self.byte_offset(end),
            is_unparsed,
            begin_cp: begin as u32,
            end_cp: end as u32,
        }
    }

    /// Core tokenization: port of Java `tokenizeAt`.  Returns the next
    /// regular or unparsed token starting at code point `position`.  `SKIP`
    /// matches and `MORE` prefixes are folded into the loop, lexical state
    /// transitions are applied, and lexical actions run for every match.
    pub(crate) fn tokenize_at(&mut self, mut position: usize) -> Token {
        // Like Java, the loop works with a local copy of the lexical state:
        // transitions update both the copy and the field, while a
        // `switchTo` inside a lexical action only updates the field (and so
        // takes effect from the next token on).
        let mut lexical_state = self.lexical_state;
        let mut token_begin_offset = position;
        let mut in_more = false;
        let mut matched_token: Option<Token> = None;
        while matched_token.is_none() {
            let nfa_functions = get_nfa_functions(lexical_state);
            let match_start = position;
            if !in_more {
                token_begin_offset = position;
            }
            let (matched_type, match_length) = self.get_match_info(position, nfa_functions);
            in_more = matched_type.is_more();
            position += match_length;
[#if lexerData::hasLexicalStateTransitions]
            let prev_state = lexical_state;
            if let Some(new_state) = crate::tokens::lexical_state_for(matched_type) {
                lexical_state = new_state;
                self.lexical_state = new_state;
            }
[/#if]
            if matched_type == TokenType::INVALID {
                // Rust divergence (see the struct docs): one INVALID token per
                // code point, including any MORE prefix accumulated so far.
                return self.make_token(TokenType::INVALID, token_begin_offset, match_start + 1, false);
            }
[#if emulateLongBracketHook]
            // Emulation of the grammar's Java TOKEN_HOOK for long brackets
            // (e.g. Lua `[==[ ... ]==]`): the NFA cannot check that the
            // closing bracket has as many `=` as the opening one.  If it does
            // not, back up one character and keep accumulating.
            if !in_more
                && match_start > token_begin_offset
                && !Self::balanced_delimiters(&self.chars, token_begin_offset, position)
            {
                position -= 1;
                in_more = true;
                lexical_state = prev_state;
                self.lexical_state = prev_state;
                continue;
            }
[/#if]
            if matched_type.is_skipped() {
                // Java skipTokens(): nothing is recorded for skipped text.
            } else if matched_type.is_regular() || matched_type.is_unparsed() {
                matched_token = Some(self.make_token(
                    matched_type,
                    token_begin_offset,
                    position,
                    !matched_type.is_regular(),
                ));
            }
[#if lexerData::hasTokenActions]
            matched_token = self.token_lexical_actions(
                matched_token,
                matched_type,
                token_begin_offset,
                match_start,
                position,
            );
[/#if]
        }
        matched_token.expect("the tokenization loop only exits with a token")
    }

    /// Runs the NFA from code point `start` and returns the matched type and
    /// match length (port of Java `getMatchInfo`).  The longest match wins;
    /// among matches of equal length, the type with the lowest ordinal wins.
    /// At end of input it returns `(EOF, 0)`; if nothing matches it returns
    /// `(INVALID, 0)`.
    fn get_match_info(&mut self, start: usize, nfa_functions: &[NfaFunction]) -> (TokenType, usize) {
        let input_len = self.chars.len();
        if start >= input_len {
            return (TokenType::EOF, 0);
        }
        // `None` means that every type is active (Java passes null).
        let valid_types: &TokenTypeSet = self.active_token_types.as_ref().unwrap_or(&TokenTypeSet::ALL_TYPES);
        let mut already_matched = TokenTypeSet::new();
        let chars = &self.chars;
        let current = &mut self.current_states;
        let next = &mut self.next_states;
        current.iter_mut().for_each(|w| *w = 0);
        next.iter_mut().for_each(|w| *w = 0);
        let mut position = start;
        let mut match_length: usize = 0;
        let mut matched_type = TokenType::INVALID;
        loop {
            if position > start {
                // What was the next-state set is now the current one.
                std::mem::swap(current, next);
                next.iter_mut().for_each(|w| *w = 0);
            } else {
                current[0] |= 1;
            }
            if position >= input_len {
                break;
            }
            let cur_char = chars[position] as u32;
            position += 1;
            for word_index in 0..current.len() {
                let mut bits = current[word_index];
                while bits != 0 {
                    let state_index = (word_index << 6) | bits.trailing_zeros() as usize;
                    bits &= bits - 1;
                    if let Some(returned) =
                        nfa_functions[state_index](cur_char, next, valid_types, &already_matched)
                    {
                        if position - start > match_length || returned < matched_type {
                            matched_type = returned;
                            match_length = position - start;
                            already_matched.insert(returned);
                        }
                    }
                }
            }
            if position >= input_len || next.iter().all(|&w| w == 0) {
                break;
            }
        }
        (matched_type, match_length)
    }

    // =============================================================
    // Helpers used by code translated from Java lexical actions and
    // INJECT LEXER_CLASS methods.  Offsets are code points (`i32`, as
    // in Java); they panic with a description when an offset lies
    // outside the content, which is where Java would throw
    // StringIndexOutOfBoundsException.
    // =============================================================

    fn offset_panic(&self, what: &str, offset: i32) -> ! {
        panic!(
            "{}: offset {} is outside the lexer content (0..={} code points) of '{}'; \
             this is an error in a lexical action or INJECT LEXER_CLASS code of the grammar",
            what,
            offset,
            self.chars.len(),
            self.source_name
        )
    }

    /// Java `charAt(index)` on the lexer content.
    pub fn char_at(&self, index: i32) -> char {
        match usize::try_from(index).ok().and_then(|i| self.chars.get(i)) {
            Some(&c) => c,
            None => self.offset_panic("charAt", index),
        }
    }

    /// Java `tok.charAt(index)`: the character at `index` within the token.
    pub fn token_char_at(&self, tok: &Token, index: i32) -> char {
        self.char_at(tok.begin_cp as i32 + index)
    }

    fn checked_offset(&self, what: &str, offset: i32) -> usize {
        match usize::try_from(offset) {
            Ok(o) if o <= self.chars.len() => o,
            _ => self.offset_panic(what, offset),
        }
    }

    /// Java `tok.setBeginOffset(offset)`.
    pub fn set_token_begin_offset(&self, tok: &mut Token, offset: i32) {
        let cp = self.checked_offset("setBeginOffset", offset);
        tok.begin_cp = cp as u32;
        tok.start = self.byte_offset(cp);
    }

    /// Java `tok.setEndOffset(offset)`.
    pub fn set_token_end_offset(&self, tok: &mut Token, offset: i32) {
        let cp = self.checked_offset("setEndOffset", offset);
        tok.end_cp = cp as u32;
        tok.end = self.byte_offset(cp);
    }

    /// Java `tok.truncate(amount)`: moves the end back by `amount` code
    /// points, but never before the beginning.
    pub fn truncate_token(&self, tok: &mut Token, amount: i32) {
        let new_end = std::cmp::max(tok.get_begin_offset(), tok.get_end_offset() - amount);
        self.set_token_end_offset(tok, new_end);
    }

    /// Java `tok.replaceType(type)`: the same token with another type.
    pub fn replace_token_type(&self, tok: Token, kind: TokenType) -> Token {
        Token { kind, ..tok }
    }

[#if lexerData::hasTokenActions]
    /// Lexical actions (port of Java `tokenLexicalActions`).  Called after
    /// every match, including `MORE` and `SKIP` matches, for which
    /// `matched_token` is `None`.  Returning `None` makes the lexer continue
    /// scanning.  `token_begin_offset` and `match_start` differ only while
    /// `MORE` text is being accumulated.
    #[allow(unused_mut, unused_variables, unused_assignments, unreachable_code, unused_parens)]
    fn token_lexical_actions(
        &mut self,
        matched_token: Option<Token>,
        matched_type: TokenType,
        token_begin_offset: usize,
        match_start: usize,
        match_end: usize,
    ) -> Option<Token> {
        let mut matched_token = matched_token;
        let token_begin_offset = token_begin_offset as i32;
        let match_start = match_start as i32;
        let match_end = match_end as i32;
        match matched_type {
[#list lexerData::regularExpressions as regexp]
  [#if regexp::codeSnippet??]
            TokenType::${regexp::label} => {
                // Code action from ${regexp::codeSnippet::location}
${globals.rustLexerAction(regexp)}
            }
  [/#if]
[/#list]
            _ => {}
        }
        matched_token
    }
[/#if]

[#if emulateLongBracketHook]
    /// Checks whether a MORE-accumulated token has balanced long-bracket
    /// delimiters: Lua-style long strings (`[==[...]==]`) and long comments
    /// (`--[==[...]==]`) need as many `=` in the closing delimiter as in
    /// the opening one, which the NFA cannot enforce.
    ///
    /// Returns `true` if the delimiters are balanced or the token does
    /// not use bracket delimiters (i.e., no validation needed).
    fn balanced_delimiters(chars: &[char], begin: usize, end: usize) -> bool {
        if begin >= end || end > chars.len() {
            return true;
        }
        // Find the opening pattern: optional "--" prefix, then "[" "="* "[".
        let mut idx = begin;
        if idx + 1 < end && chars[idx] == '-' && chars[idx + 1] == '-' {
            idx += 2;
        }
        if idx >= end || chars[idx] != '[' {
            return true;
        }
        idx += 1;
        let mut open_equals: usize = 0;
        while idx < end && chars[idx] == '=' {
            open_equals += 1;
            idx += 1;
        }
        if idx >= end || chars[idx] != '[' {
            return true;
        }
        // Find the closing pattern at the end: "]" "="* "]".
        let mut ridx = end - 1;
        if chars[ridx] != ']' {
            return true;
        }
        ridx = ridx.saturating_sub(1);
        let mut close_equals: usize = 0;
        while ridx > begin && chars[ridx] == '=' {
            close_equals += 1;
            ridx = ridx.saturating_sub(1);
        }
        if chars[ridx] != ']' {
            return true;
        }
        open_equals == close_equals
    }
[/#if]

[#-- Methods from INJECT LEXER_CLASS --]
${globals.rustLexerMethods()}
}

[#-- === Macros generating the NFA functions (see NfaCode.java.ctl) === --]
[#macro InitialCompositeNfa state lexicalState]
/// Initial NFA state for lexical state ${lexicalState::name}.
fn ${state::methodName}(ch: u32, next_states: &mut [u64], valid_types: &TokenTypeSet, _already_matched: &TokenTypeSet) -> Option<TokenType> {
    let mut matched_type: Option<TokenType> = None;
[#var states = state::orderedStates, lastBlockStartIndex = 0]
[#list states as nfaState]
  [#if nfaState_index == 0 || !nfaState::moveRanges.equals(states[nfaState_index - 1]::moveRanges)]
    [#if nfaState_index == 0 || nfaState.overlaps(states.subList(lastBlockStartIndex, nfaState_index))]
      [#set lastBlockStartIndex = nfaState_index]
    if [@NfaStateCondition nfaState /] {
    [#else]
    else if [@NfaStateCondition nfaState /] {
    [/#if]
  [/#if]
        if valid_types.contains(TokenType::${nfaState::type::label}) {
  [#if nfaState::nextStateIndex >= 0]
            bitset_set(next_states, ${nfaState::nextStateIndex});
  [/#if]
  [#if !nfaState_has_next || !nfaState::moveRanges.equals(states[nfaState_index + 1]::moveRanges)]
    [#if nfaState::nextState::final]
            matched_type = Some(TokenType::${nfaState::type::label});
    [/#if]
        }
    }
  [#else]
        }
  [/#if]
[/#list]
    matched_type
}

[/#macro]

[#macro SimpleNfa state lexicalState]
[#var nfaState = state::singleState]
/// NFA state ${state::methodName} for lexical state ${lexicalState::name}.
fn ${state::methodName}(ch: u32, next_states: &mut [u64], _valid_types: &TokenTypeSet, already_matched: &TokenTypeSet) -> Option<TokenType> {
[#if lexerData.isLazy(nfaState::type)]
    if already_matched.contains(TokenType::${nfaState::type::label}) {
        return None;
    }
[#else]
    let _ = already_matched;
[/#if]
    if [@NfaStateCondition nfaState /] {
[#if nfaState::nextStateIndex >= 0]
        bitset_set(next_states, ${nfaState::nextStateIndex});
[/#if]
[#if nfaState::nextState::final]
        return Some(TokenType::${nfaState::type::label});
[/#if]
    }
[#if nfaState::nextStateIndex < 0]
    let _ = next_states;
[/#if]
    None
}

[/#macro]

[#macro CompositeNfa state lexicalState]
/// NFA composite state ${state::methodName} for lexical state ${lexicalState::name}.
fn ${state::methodName}(ch: u32, next_states: &mut [u64], _valid_types: &TokenTypeSet, already_matched: &TokenTypeSet) -> Option<TokenType> {
[#if lexerData.isLazy(state::type)]
    if already_matched.contains(TokenType::${state::type::label}) {
        return None;
    }
[#else]
    let _ = already_matched;
[/#if]
[#if state::hasFinalState]
    let mut matched_type: Option<TokenType> = None;
[/#if]
[#var states = state::orderedStates, lastBlockStartIndex = 0]
[#list states as nfaState]
  [#if nfaState_index == 0 || !nfaState::moveRanges.equals(states[nfaState_index - 1]::moveRanges)]
    [#if nfaState_index == 0 || nfaState.overlaps(states.subList(lastBlockStartIndex, nfaState_index))]
      [#set lastBlockStartIndex = nfaState_index]
    if [@NfaStateCondition nfaState /] {
    [#else]
    else if [@NfaStateCondition nfaState /] {
    [/#if]
  [/#if]
  [#if nfaState::nextStateIndex >= 0]
        bitset_set(next_states, ${nfaState::nextStateIndex});
  [/#if]
  [#if !nfaState_has_next || !nfaState::moveRanges.equals(states[nfaState_index + 1]::moveRanges)]
    [#if nfaState::nextState::final]
        matched_type = Some(TokenType::${nfaState::type::label});
    [/#if]
    }
  [/#if]
[/#list]
[#if state::hasFinalState]
    matched_type
[#else]
    let _ = next_states;
    None
[/#if]
}

[/#macro]

[#-- === Macro for generating NFA state condition === --]
[#macro NfaStateCondition nfaState]
[#if nfaState::moveRanges.size() < NFA_RANGE_THRESHOLD]
[@RangesCondition nfaState::moveRanges /]
[#elseif nfaState::hasAsciiMoves && nfaState::hasNonAsciiMoves]
([@RangesCondition nfaState::asciiMoveRanges /]) || (ch >= 128 && check_intervals(${nfaState::movesArrayName.toUpperCase()}, ch))
[#else]
check_intervals(${nfaState::movesArrayName.toUpperCase()}, ch)
[/#if]
[/#macro]

[#-- Recursive macro for inline character range conditions.
     Uses numeric codepoint values directly to avoid Rust's restricted char escapes
     (Rust does not support \f, \b, etc.). --]
[#macro RangesCondition moveRanges]
[#var left = moveRanges[0], right = moveRanges[1]]
[#var singleChar = left == right]
[#if moveRanges.size() == 2]
  [#if singleChar]
ch == ${left}
  [#elseif left + 1 == right]
ch == ${left} || ch == ${right}
  [#elseif left > 0]
ch >= ${left}[#if right < 1114111] && ch <= ${right}[/#if]
  [#else]
ch <= ${right}
  [/#if]
[#else]
([@RangesCondition moveRanges[0..1] /]) || ([@RangesCondition moveRanges[2..] /])
[/#if]
[/#macro]
