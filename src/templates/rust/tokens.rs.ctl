/// Token types for this grammar.
///
/// Each variant corresponds to a token defined in the grammar specification.
/// The discriminant values match the order in which tokens are defined,
/// enabling efficient set membership tests.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
#[repr(u16)]
pub enum TokenType {
[#list lexerData::regularExpressions as regexp]
    ${regexp::label} = ${regexp_index},
[/#list]
[#var nextOrdinal = lexerData::regularExpressions.size()]
[#list settings::extraTokenNames as extraToken]
    ${extraToken} = ${nextOrdinal},
    [#set nextOrdinal = nextOrdinal + 1]
[/#list]
    /// Sentinel for the end of a sequence of tokens with no more pending.
    DUMMY = ${nextOrdinal},
    /// Placeholder for invalid/unrecognized input.
    INVALID = ${nextOrdinal + 1},
}

impl TokenType {
    /// Total number of defined token types (excluding DUMMY and INVALID).
    pub const COUNT: usize = ${lexerData::regularExpressions.size() + settings::extraTokenNames.size()};

    /// Number of variants including the `DUMMY` and `INVALID` sentinels.
    pub const NUM_VARIANTS: usize = Self::COUNT + 2;

    /// Every variant, in ordinal (declaration) order.  `ALL[t.ordinal()] == t`
    /// holds for every `t`, which lets code map ordinals back to variants
    /// without `unsafe` transmutes.
    pub const ALL: [TokenType; ${lexerData::regularExpressions.size() + settings::extraTokenNames.size() + 2}] = [
[#list lexerData::regularExpressions as regexp]
        TokenType::${regexp::label},
[/#list]
[#list settings::extraTokenNames as extraToken]
        TokenType::${extraToken},
[/#list]
        TokenType::DUMMY,
        TokenType::INVALID,
    ];

    /// Returns the ordinal of this token type (its position in [`TokenType::ALL`]).
    /// Ordinals match the Java `TokenType.ordinal()` values of the same grammar.
    #[inline]
    pub const fn ordinal(self) -> usize {
        self as u16 as usize
    }

    /// Returns the token type with the given ordinal, or `None` if the
    /// ordinal is out of range.
    #[inline]
    pub fn from_ordinal(ordinal: usize) -> Option<TokenType> {
        Self::ALL.get(ordinal).copied()
    }

    /// Returns `true` if this token type was declared with `[IGNORE_CASE]`.
    /// Contextual keywords that ignore case match identifiers case-insensitively,
    /// exactly like `TokenType.isIgnoreCase()` in the Java target.
    #[allow(clippy::match_like_matches_macro)]
    pub fn is_ignore_case(self) -> bool {
        match self {
[#list lexerData::regularExpressions as regexp]
  [#if regexp::ignoreCase]
            TokenType::${regexp::label} => true,
  [/#if]
[/#list]
            _ => false,
        }
    }

    /// Returns `true` if this token type is a regular (parsing) token.
    pub fn is_regular(self) -> bool {
        matches!(self,
[#list lexerData::regularTokens::tokenNames as name]
            TokenType::${name}[#if name_has_next] |[#else])[/#if]
[/#list]
    }

    /// Returns `true` if this token type is skipped (e.g., whitespace, comments).
    pub fn is_skipped(self) -> bool {
[#if lexerData::skippedTokens::tokenNames.size() == 0]
        false
[#else]
        matches!(self,
[#list lexerData::skippedTokens::tokenNames as name]
            TokenType::${name}[#if name_has_next] |[#else])[/#if]
[/#list]
[/#if]
    }

    /// Returns `true` if this token type is unparsed (SPECIAL_TOKEN / UNPARSED).
    pub fn is_unparsed(self) -> bool {
[#if lexerData::unparsedTokens::tokenNames.size() == 0]
        false
[#else]
        matches!(self,
[#list lexerData::unparsedTokens::tokenNames as name]
            TokenType::${name}[#if name_has_next] |[#else])[/#if]
[/#list]
[/#if]
    }

    /// Returns `true` if this token type is a MORE token (pending additional input).
    pub fn is_more(self) -> bool {
[#if lexerData::moreTokens::tokenNames.size() == 0]
        false
[#else]
        matches!(self,
